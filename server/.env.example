MONGO_URI=mongodb://127.0.0.1:27017/noteus
JWT_SECRET=change-this-to-something-long-and-random
JWT_EXPIRES_IN=30m
PORT=4000

# Who's allowed to call this API (CORS), for both the REST routes and the
# Socket.io "yard" — see src/config/corsOrigin.js.
#   - Leave unset/blank to allow any origin — the easy default for local
#     dev, including opening the client from another device on the same
#     network (a phone over ZeroTier/LAN using the PC's ZeroTier/LAN IP
#     instead of localhost). Fine as long as this server itself isn't
#     exposed to the public internet.
#   - A single URL locks it to just that origin.
#   - A comma-separated list allows exactly those origins — use this in
#     production, e.g.:
#     CLIENT_ORIGIN=https://noteus.example.com,http://192.168.1.20:5173
CLIENT_ORIGIN=
