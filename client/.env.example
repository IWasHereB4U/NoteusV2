# Only needed when the client is deployed separately from the API (e.g.
# client on Vercel, server on Render/Railway/Fly/a VPS). Set this to the
# API's origin, no trailing slash — e.g. https://noteus-api.onrender.com
#
# Leave unset for local dev: the Vite proxy in vite.config.js already
# forwards /api, /socket.io and /uploads to http://localhost:4000.
VITE_API_URL=

# Only needed if you want `npm run dev` to proxy to something other than
# your local server (http://localhost:4000) — e.g. a deployed backend for
# testing against shared/staging data. Leave unset for normal local dev,
# so login and everything else goes straight to your local server + local
# database instead of a deployed backend (which can reject requests with
# 402 Payment Required if that deployment's plan/usage limit is hit, even
# though your machine is running fine).
VITE_API_PROXY_TARGET=
